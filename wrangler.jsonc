{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ensd-arabic-praimery",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "HISTORY_KV" }
  ],
  "d1_databases": [
  {
    "binding": "DB",
    "database_name": "ensd-arabic-db",
    "database_id": "65477e7f-d415-4cda-afc3-5ba224d7393f"
  }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
