{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ensd-arabic-praimery",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "exclude": [
      "src/**",
      "node_modules/**",
      ".git/**",
      "package.json",
      "wrangler.jsonc",
      "README.md",
      "netlify.toml"
    ]
  }
}
